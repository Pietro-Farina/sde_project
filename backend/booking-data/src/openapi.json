      "post": {
        "operationId": "createAReservationAtomically",
        "tags": [
          "reservations"
        ],
        "summary": "Create a reservation and hold slot availability atomically.",
        "description": "Creates a new reservation for a course by atomically validating slot availability, decrementing available capacity, and persisting the reservation in a single database transaction.\n\nAll specified slots must exist within the course and have sufficient availability.If any validation fails, no changes are applied.\n\nThe reservation is created in a `held` state and includes an expiration timestamp after which it may be automatically cleaned up.",
        "responses": {
          "201": {
            "description": "The request was successful: a new reservation was created and the slot availability was updated accordingly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "reservation": {
                          "$ref": "#/components/schemas/Reservation"
                        }
                      },
                      "required": [
                        "reservation"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "examples": {
                  "createReservationResponse": {
                    "summary": "Example reservation creation response",
                    "value": {
                      "data": {
                        "reservation": {
                          "course": "695ba111b2e63b75bee66279",
                          "user": "648a1f4e2f8fb814c8d6f9b1",
                          "slots": [
                            "695ee7f30b5f48720cad5c81"
                          ],
                          "status": "held",
                          "expiration": "2026-01-16T00:19:18.552Z",
                          "_id": "6969808214d2f13caa1e5f16",
                          "createdAt": "2026-01-16T00:04:18.557Z",
                          "updatedAt": "2026-01-16T00:04:18.557Z",
                          "__v": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "requestBody": {
          "required": true,
          "description": "",
          "content": {
            "application/json": {
