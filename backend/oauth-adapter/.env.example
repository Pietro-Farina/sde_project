PORT=3004

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3004/api/oauth/google/callback

INTERNAL_ASSERTION_SECRET=super_shared_secret_between_services

# Where orchestrator should send the user after login is completed
ORCHESTRATOR_INTERNAL_ASSERT_URL=http://localhost:3000/api/v1/auth/internal/assert
ORCHESTRATOR_COMPLETE_URL=http://localhost:3000/api/v1/auth/complete
FRONTEND_REDIRECT_URL=http://localhost:5173