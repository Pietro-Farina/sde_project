{
  "openapi": "3.1.0",
  "info": {
    "title": "Booking Orchestrator API",
    "description": "Main orchestration service that coordinates authentication, bookings, and course management",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login/{provider}": {
      "get": {
        "operationId": "login",
        "tags": ["authentication"],
        "summary": "Initiate OAuth login",
        "description": "Redirects the user to the OAuth adapter for the specified provider to begin authentication.",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "description": "OAuth provider name (currently only 'google' is supported)",
            "schema": {
              "type": "string",
              "enum": ["google"]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to OAuth adapter",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "OAuth adapter URL"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/auth/complete": {
      "get": {
        "operationId": "completeLogin",
        "tags": ["authentication"],
        "summary": "Complete OAuth login",
        "description": "Finalizes the OAuth login process after the adapter redirects back. Sets access and refresh token cookies and redirects to frontend.",
        "parameters": [
          {
            "in": "query",
            "name": "nonce",
            "required": true,
            "description": "Unique nonce from the OAuth flow",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to frontend with authentication cookies set",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Frontend redirect URL"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": "access_token and refresh_token cookies"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["authentication"],
        "summary": "Logout user",
        "description": "Revokes the refresh token and clears authentication cookies.",
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshAccessToken",
        "tags": ["authentication"],
        "summary": "Refresh access token",
        "description": "Uses the refresh token cookie to issue new access and refresh tokens.",
        "responses": {
          "204": {
            "description": "Tokens refreshed successfully",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": "New access_token and refresh_token cookies"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getAuthenticatedUser",
        "tags": ["authentication"],
        "summary": "Get authenticated user info",
        "description": "Returns information about the currently authenticated user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": {
                      "type": "boolean"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "picture": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "meResponse": {
                    "summary": "Example user info response",
                    "value": {
                      "authenticated": true,
                      "userId": "google:123456789",
                      "picture": "https://example.com/photo.jpg"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/internal/assert": {
      "post": {
        "operationId": "oauthAssert",
        "tags": ["authentication"],
        "summary": "Internal OAuth assertion endpoint",
        "description": "Internal endpoint used by OAuth adapters to submit verified user assertions. Not intended for direct client use.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "sub": {
                    "type": "string"
                  },
                  "iat": {
                    "type": "integer"
                  },
                  "nonce": {
                    "type": "string"
                  },
                  "signature": {
                    "type": "string"
                  },
                  "picture": {
                    "type": "string"
                  },
                  "frontendRedirectUrl": {
                    "type": "string"
                  }
                },
                "required": ["provider", "sub", "nonce", "signature"]
              }
            }
          }
        },
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/courses": {
      "get": {
        "operationId": "getAllCourses",
        "tags": ["courses"],
        "summary": "Get all courses",
        "description": "Returns a list of all available courses.",
        "responses": {
          "200": {
            "description": "Courses retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "courses": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Course"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/courses/{id}": {
      "get": {
        "operationId": "getCourseById",
        "tags": ["courses"],
        "summary": "Get course by ID",
        "description": "Returns detailed information about a specific course.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Course ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "course": {
                          "$ref": "#/components/schemas/Course"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/bookings": {
      "get": {
        "operationId": "getUserBookings",
        "tags": ["bookings"],
        "summary": "Get user bookings",
        "description": "Returns all bookings for the authenticated user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bookings retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "bookings": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Booking"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/api/v1/bookings/start": {
      "post": {
        "operationId": "startBookingProcess",
        "tags": ["bookings"],
        "summary": "Start booking process",
        "description": "Initiates the booking process by creating a reservation and payment order.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string"
                  },
                  "slotIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reservationId": {
                    "type": "string",
                    "description": "Optional existing reservation id to reuse instead of creating a new one"
                  }
                },
                "required": ["courseId", "slotIds"]
              },
              "examples": {
                "startBookingRequest": {
                  "summary": "Example start booking request",
                  "value": {
                    "courseId": "695ba111b2e63b75bee66279",
                    "slotIds": ["695ba111b2e63b75bee6627b"],
                    "reservationId": "696prev1234567890abcdef"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking process started successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "reservationId": {
                          "type": "string"
                        },
                        "priceToPay": {
                          "type": "string"
                        },
                        "orderID": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "startBookingResponse": {
                    "summary": "Example start booking response",
                    "value": {
                      "data": {
                        "reservationId": "6969808214d2f13caa1e5f16",
                        "priceToPay": "49.00",
                        "orderID": "8VX12345AB6789012"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/api/v1/bookings/confirm": {
      "post": {
        "operationId": "confirmBooking",
        "tags": ["bookings"],
        "summary": "Confirm booking",
        "description": "Confirms a booking by capturing payment and creating the final booking record. If booking fails after payment capture, automatically initiates a refund.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "orderID": {
                    "type": "string"
                  },
                  "reservationId": {
                    "type": "string"
                  }
                },
                "required": ["orderID", "reservationId"]
              },
              "examples": {
                "confirmBookingRequest": {
                  "summary": "Example confirm booking request",
                  "value": {
                    "orderID": "8VX12345AB6789012",
                    "reservationId": "6969808214d2f13caa1e5f16"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking confirmed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "booking": {
                          "$ref": "#/components/schemas/Booking"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/api/v1/bookings/reservations/pending": {
      "post": {
        "operationId": "getPendingReservation",
        "tags": ["bookings"],
        "summary": "Get pending reservation",
        "description": "Retrieves the active pending reservation for the authenticated user and specified course.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string"
                  }
                },
                "required": ["courseId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pending reservation retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "reservation": {
                          "$ref": "#/components/schemas/Reservation"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/api/v1/bookings/reservations/{reservationId}/cancel": {
      "patch": {
        "operationId": "cancelReservation",
        "tags": ["bookings"],
        "summary": "Cancel reservation",
        "description": "Cancels a pending reservation for the authenticated user.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "reservationId",
            "required": true,
            "description": "Reservation ID to cancel",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The server could not understand the request due to invalid syntax",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "badRequestExample": {
                "summary": "Example bad request response",
                "value": {
                  "error": {
                    "code": "INVALID_REQUEST",
                    "message": "courseId and slotIds are required."
                  }
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is required and has failed or not been provided",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "unauthorizedExample": {
                "summary": "Example unauthorized response",
                "value": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "Access Denied."
                  }
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "The client does not have access rights to the content",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "forbiddenErrorResponse": {
                "summary": "Example forbidden error response",
                "value": {
                  "error": {
                    "code": "ACCESS_DENIED",
                    "message": "User do not have permission to access this reservation."
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The server cannot find the requested resource",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "notFoundErrorResponse": {
                "summary": "Example not found error response",
                "value": {
                  "error": {
                    "code": "RESERVATION_NOT_FOUND",
                    "message": "No active reservation found for the specified user and course."
                  }
                }
              }
            }
          }
        }
      },
      "Conflict": {
        "description": "The request could not be completed due to a conflict",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "conflictErrorResponse": {
                "summary": "Example conflict error response",
                "value": {
                  "error": {
                    "code": "RESERVATION_NOT_ACTIVE",
                    "message": "Reservation is not active"
                  }
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "The server encountered an unexpected condition",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "internalServerErrorResponse": {
                "summary": "Example server error response",
                "value": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "An unexpected error occurred while processing the request."
                  }
                }
              }
            }
          }
        }
      },
      "BadGateway": {
        "description": "The server received an invalid response from the upstream server",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "badGatewayErrorResponse": {
                "summary": "Example bad gateway error response",
                "value": {
                  "error": {
                    "code": "DEPENDENCY_ERROR",
                    "message": "A dependent service failed."
                  }
                }
              }
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The server is currently unavailable",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "serviceUnavailableErrorResponse": {
                "summary": "Example service unavailable error response",
                "value": {
                  "error": {
                    "code": "DEPENDENCY_UNAVAILABLE",
                    "message": "A dependent service is unavailable."
                  }
                }
              }
            }
          }
        }
      },
      "GatewayTimeout": {
        "description": "The server did not receive a timely response from the upstream server",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "examples": {
              "gatewayTimeoutErrorResponse": {
                "summary": "Example gateway timeout error response",
                "value": {
                  "error": {
                    "code": "DEPENDENCY_TIMEOUT",
                    "message": "A dependent service timed out."
                  }
                }
              }
            }
          }
        }
      },
      "NoContent": {
        "description": "The request was successful, but there is no content to return"
      }
    },
    "schemas": {
      "Course": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string"
                },
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                },
                "capacity": {
                  "type": "integer"
                },
                "available": {
                  "type": "integer"
                }
              }
            }
          },
          "open": {
            "type": "boolean"
          },
          "priceOptions": {
